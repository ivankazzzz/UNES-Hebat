{
  "mcpServers": {
    "dbAbsensiUNES": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref=fxwtdohwjylsptcnoxhe"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_ACCESS_TOKEN_HERE"
      },
      "alwaysAllow": [
        "list_tables",
        "get_project_url",
        "get_advisors",
        "query",
        "read",
        "insert",
        "update",
        "delete",
        "schema_list",
        "schema_get"
      ]
    }
  }
}
