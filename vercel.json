{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://kehadiran.irfanananda28.com/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/telegram-evidence",
      "destination": "/api/telegram-evidence.ts"
    },
    {
      "source": "/api/telegram-photo",
      "destination": "/api/telegram-photo.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
