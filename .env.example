VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Feature flags
# Set to true untuk memunculkan menu/halaman Absensi Mengajar
VITE_ENABLE_TEACHING_ATTENDANCE=false

# Telegram Chat ID untuk bukti absensi (frontend)
VITE_ATTENDANCE_TELEGRAM_CHAT_ID=your_attendance_telegram_chat_id_here

# Telegram Bot Configuration (for backend API)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_TARGET_CHAT_ID=your_target_chat_id_here

# Telegram Bot Token for Frontend (to fetch photos in PDF)
# This should be the same as TELEGRAM_BOT_TOKEN above
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

